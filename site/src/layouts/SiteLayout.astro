---
interface Props { title: string; description: string; current?: "home" | "runs" | "benchmarks" | "docs"; }
const { title, description, current = "home" } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#101312" />
    <link rel="icon" href={`${base}favicon.svg`} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} · SQL 模型评测台`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <title>{title} · SQL 模型评测台</title>
  </head>
  <body>
    <a class="skip-link" href="#main">跳到主要内容</a>
    <div class="site-shell">
      <header class="masthead">
        <a class="wordmark" href={base} aria-label="拾穗数据工作室 SQL 模型评测台首页"><span class="wordmark-mark">拾</span><span><b>拾穗数据工作室</b><small>SQL 模型评测台</small></span></a>
        <nav aria-label="主导航"><a class:list={[{ active: current === "runs" }]} href={`${base}runs/`}>评测报告</a><a class:list={[{ active: current === "benchmarks" }]} href={`${base}benchmarks/`}>测试用例</a><a class:list={[{ active: current === "docs" }]} href={`${base}docs/`}>评测方法</a><a href="https://github.com/shisuidata/text-to-sql-arena">源与证据 ↗</a></nav>
      </header>
      <main id="main"><slot /></main>
      <footer class="site-footer"><p><b>拾穗数据工作室</b></p><a href={`${base}docs/methodology/`}>评分方法</a><a href="https://github.com/shisuidata/text-to-sql-arena">GitHub 仓库 ↗</a></footer>
    </div>
  </body>
</html>
<style is:global>@import "../styles/site.css";</style>
