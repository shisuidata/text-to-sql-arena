---
import ModelIdentity from "../components/ModelIdentity.astro";
import RunCard from "../components/RunCard.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { displayModelName, formatDate, getCaseRounds, getEvidenceIndex, getRuns, runSlug, scoreText } from "../lib/evidence";

const [index, runs] = await Promise.all([getEvidenceIndex(), getRuns()]);
const latest = runs.find(({ report }) => report.models.some((model) => model.official_score != null)) ?? runs[0];
const base = import.meta.env.BASE_URL;
const keyRounds = (latest ? getCaseRounds(latest.report) : [])
  .filter((item) => item.spread > 0)
  .sort((a, b) => b.spread - a.spread)
  .slice(0, 3);
const sampleSize = latest?.report.selected_case_keys.length ?? 0;
---
<SiteLayout title="首页" description="Text-to-SQL 模型评测结果、逐题评分、测试用例与原始记录。" current="home">
  <header class="hero">
    <div class="hero-copy">
      <h1 class="hero-title">Text-to-SQL 评测</h1>
      <p class="page-lede">查看模型得分、逐题结果、测试用例和原始记录。</p>
      <div class="hero-actions">
        {latest && <a class="button-link primary" href={`${base}runs/${runSlug(latest.report.id)}/`}>最新评测报告</a>}
        <a class="button-link" href={`${base}benchmarks/`}>测试用例</a>
      </div>
    </div>
    <aside class="hero-rail" aria-label="公开证据规模">
      <div class="rail-label">公开样本</div>
      <div class="rail-stats">
        <div class="rail-stat"><b>{index.run_count}</b><span>已发布运行</span></div>
        <div class="rail-stat"><b>{index.suite_count}</b><span>锁定题库版本</span></div>
        <div class="rail-stat"><b>{sampleSize || "—"}</b><span>最新运行题数</span></div>
      </div>
      <div class="rail-proof">证据协议 <code>{index.schema_version}</code></div>
    </aside>
  </header>

  {latest && <>
    <section class="section lead-story">
      <div class="story-heading">
        <p class="kicker">运行 #{latest.report.id} · {formatDate(latest.report.created_at)}</p>
        <h2>最新评测结果</h2>
        <p>{latest.report.models.length} 个模型，{sampleSize} 道题。综合得分为规则加权分，不是正确率；结果仅适用于本次题库和配置。</p>
      </div>
      <div class="scoreboard" aria-label={`运行 ${latest.report.id} 综合得分`}>
        {latest.report.models.map((model, index) => <article class:list={["scoreboard-team", index % 2 === 0 ? "team-cyan" : "team-orange"]}>
          <p>{model.resolved_model_id ?? model.requested_model_id}</p>
          <h3><ModelIdentity name={model.name} modelId={model.resolved_model_id ?? model.requested_model_id} adapterKind={model.adapter_kind}/></h3>
          <strong>{scoreText(model.official_score)}</strong>
          <span>综合得分 / 100</span>
        </article>)}
      </div>
      <div class="story-actions">
        <a class="button-link primary" href={`${base}runs/${runSlug(latest.report.id)}/`}>查看报告</a>
        <a class="button-link" href="https://github.com/shisuidata/text-to-sql-arena/tree/main/evidence">原始数据 ↗</a>
      </div>
    </section>

    {keyRounds.length > 0 && <section class="section rounds-section">
      <div class="section-heading"><h2>题目得分差异</h2><p>按模型间每题均分差降序排列，均分包含全部计划尝试。</p></div>
      <div class="round-list">
        {keyRounds.map((round, index) => <article class="round-row">
          <div class="round-index">{String(index + 1).padStart(2, "0")}</div>
          <div class="round-copy"><h3>{round.title}</h3><code>{round.stableKey}</code><p>{round.models.flatMap(({ results }) => results).find((result) => result.visible_summary)?.visible_summary ?? "本次报告没有可见业务摘要。"}</p></div>
          <div class="round-results">
            {round.models.map(({ model, mean, verdict }) => <div><span>{displayModelName(model.name)}</span><b>{scoreText(mean)}</b><small>{verdict === "correct" ? "全部作答正确*" : verdict === "incorrect" ? "作答未全对*" : "正确性未知"}</small></div>)}
          </div>
        </article>)}
      </div>
      <p class="derivation-note">* 页面仅根据执行、行结果、列名、列数与排序分项派生；不把 AST / SQL 能力分混入“结果正确”。原始评分未被修改。</p>
    </section>}
  </>}

  <section class="section">
    <div class="section-heading"><h2>最近运行</h2></div>
    <div class="run-list">{runs.slice(0, 4).map(({ index: runIndex, report }) => <RunCard index={runIndex} report={report} compact />)}</div>
    <div class="story-actions"><a class="button-link" href={`${base}runs/`}>浏览全部运行</a></div>
  </section>
</SiteLayout>
